---
import '../styles/global.css';
import { htmlLang, ogLocale, pageUrl, LANGS, type Lang, type Content } from '../lib/content';
import { fontCss, fontPreloads } from '../lib/fonts';

interface Props { lang: Lang; c: Content }
const { lang, c } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = site + pageUrl(lang);
const ogImage = `${site}${base}/og-${lang}.png`;
// 字型：標題用襯線（Source Serif 4／Noto Serif TC），內文用無襯線（Source Sans 3／Noto Sans TC）。
// 字型檔自己託管在 public/fonts/（只含網站用到的字，由 npm run fonts 產生），@font-face 直接內嵌。
const fonts = fontCss(lang, base);
const preloads = fontPreloads(lang, base);
const hreflang: Record<Lang, string> = { zh: 'zh-TW', en: 'en' };

// 結構化資料：本人（Person）與論文（ScholarlyArticle），給搜尋引擎與學術索引用。
const personId = `${site}${base}/#person`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Chao-Yuan Chiang',
  alternateName: ['姜兆源', 'Tera'],
  url: canonical,
  email: `mailto:${c.contact.email}`,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'National Sun Yat-sen University' },
  sameAs: [c.contact.linkedin, c.contact.github, c.contact.makerworld],
};
const articles = c.publications.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `${canonical}#${p.id}`,
  headline: p.title,
  abstract: p.abstract,
  author: { '@id': personId },
  inLanguage: /[一-鿿]/.test(p.title) ? 'zh-Hant' : 'en',
  isPartOf: { '@type': 'Periodical', name: p.venue },
  ...(p.year ? { datePublished: p.year.slice(0, 4) } : {}),
  ...(p.status ? { creativeWorkStatus: p.status } : {}),
}));
const jsonLd = { '@context': 'https://schema.org', '@graph': [person, ...articles] };
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{c.meta.title}</title>
  <meta name="description" content={c.meta.description} />
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={site + pageUrl(l)} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}${base}/`} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#12161b" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={c.meta.title} />
  <meta property="og:description" content={c.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={c.meta.title} />
  <meta property="og:locale" content={ogLocale[lang]} />
  {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
  <meta name="twitter:card" content="summary_large_image" />

  {preloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  <style set:html={fonts} />

  <script is:inline>
    // 深色模式：記住使用者選擇；沒選過就跟隨系統。
    try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
</body>
</html>
