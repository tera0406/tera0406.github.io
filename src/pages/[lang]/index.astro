---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import Icon from '../../components/Icon.astro';
import { content, img, pageUrl, rich, LANGS, type Lang } from '../../lib/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const c = content[lang];
const ui = c.ui;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const SEP = lang === 'zh' ? '・' : ' · ';
const COLON = lang === 'zh' ? '：' : ': ';
const sections = ['about', 'experience', 'research', 'publications', 'awards', 'activities'] as const;
const videoById = Object.fromEntries(c.videos.map((v) => [v.youtubeId, v]));
// [圖示, 名稱, 連結, 列印時顯示的文字]
const cvUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/cv/Chao-Yuan_Chiang_CV_${lang}.pdf`;
const links = [
  ['mail', ui.contact.email, `mailto:${c.contact.email}`, c.contact.email],
  ['linkedin', ui.contact.linkedin, c.contact.linkedin, 'linkedin.com/in/…243b0a317'],
  ['github', ui.contact.github, c.contact.github, 'github.com/tera0406'],
  ['box', ui.contact.makerworld, c.contact.makerworld, 'makerworld.com/@cdtera2446890'],
  ['file', ui.contact.cv, cvUrl, 'tera0406.github.io'],
] as const;
const figId = (file: string) => `fig-${file.replace(/\W/g, '-')}`;
// 最新動態：依日期由新到舊；date 是 YYYY-MM 或 YYYY。
const MONTHS_EN = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'Jun.', 'Jul.', 'Aug.', 'Sep.', 'Oct.', 'Nov.', 'Dec.'];
const fmtDate = (d: string) => {
  const [y, m] = d.split('-');
  if (!m) return y;
  return lang === 'zh' ? `${y} 年 ${Number(m)} 月` : `${MONTHS_EN[Number(m) - 1]} ${y}`;
};
const news = [...c.news].sort((a, b) => b.date.localeCompare(a.date));
---
<Base lang={lang} c={c}>
  <a class="skip-link" href="#main">{ui.skip}</a>

  <header class="topbar">
    <div class="wrap">
      <a class="brand" href="#main">{c.meta.name}</a>
      <nav class="nav" aria-label={lang === 'zh' ? '頁面區塊' : 'Sections'}>
        <ul>{sections.map((s) => <li><a href={`#${s}`}>{ui.nav[s]}</a></li>)}</ul>
      </nav>
      <div class="tools">
        <a class="btn" href={pageUrl(other)} hreflang={other === 'zh' ? 'zh-TW' : 'en'} lang={other === 'zh' ? 'zh-Hant-TW' : 'en'}
           title={ui.switchLabel} data-lang-switch={other}>{ui.switchTo}</a>
        <button class="btn" type="button" data-theme-toggle aria-pressed="false" aria-label={ui.theme} title={ui.theme}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>
  </header>

  <div class="wrap layout">
    <!-- ===== 左側個人欄 ===== -->
    <aside class="profile" aria-label={lang === 'zh' ? '個人資料' : 'Profile'}>
      <div class="profile-inner">
        <Image class="avatar" src={img(c.meta.photo.file)} alt={c.meta.photo.alt} widths={[240, 480]} sizes="240px" loading="eager" fetchpriority="high" />
        <h1 class="name">{c.meta.name}</h1>
        <p class="name-alt" lang={lang === 'en' ? 'zh-Hant-TW' : 'en'}>{c.meta.nameAlt}</p>
        <p class="role">{c.hero.role}</p>
        <p class="inst">{c.hero.inst}</p>
        <ul class="icons">
          {links.map(([icon, label, href, printText]) => (
            <li><a href={href} title={icon === 'mail' ? c.contact.email : label} aria-label={icon === 'mail' ? `${label}${COLON}${c.contact.email}` : label}
                   data-print={printText} data-email={icon === 'mail' ? c.contact.email : undefined}
                   rel={icon === 'mail' || icon === 'file' ? undefined : 'me noopener'}
                   download={icon === 'file' ? '' : undefined} type={icon === 'file' ? 'application/pdf' : undefined}><Icon name={icon} /></a></li>
          ))}
        </ul>
        <div class="card interests">
          <h2>{ui.labels.interests}</h2>
          <ul>{c.hero.interests.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </aside>

    <!-- ===== 右側內容 ===== -->
    <main id="main" tabindex="-1" class="content">
      <section class="section" id="about" aria-labelledby="h-about">
        <h2 class="section-title" id="h-about">{ui.sections.about}</h2>
        <p class="bio" set:html={rich(c.hero.summary)} />
      </section>

      <section class="section" id="news" aria-labelledby="h-news">
        <h2 class="section-title" id="h-news">{ui.sections.news}</h2>
        <ul class="news">
          {news.map((n) => (
            <li>
              <time class="num" datetime={n.date}>{fmtDate(n.date)}</time>
              <span class="news-text">
                <span class="pill upcoming" hidden>{ui.labels.upcoming}</span>
                {n.text}{n.link && <>&nbsp;<a class="news-link" href={`#${n.link}`} aria-label={`${n.text} ${ui.labels.more}`}>↗</a></>}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="section" id="education" aria-labelledby="h-edu">
        <h2 class="section-title" id="h-edu">{ui.sections.education}</h2>
        <div class="stack">
          {c.education.map((e) => (
            <article class="card entry">
              <div class="entry-head">
                <h3>{e.degree}</h3>
                <span class="pill num">{e.badge}</span>
              </div>
              <p class="accent">{e.school}</p>
              <p class="muted">{e.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="h-exp">
        <h2 class="section-title" id="h-exp">{ui.sections.experience}</h2>
        <div class="stack">
          {c.experience.map((x) => (
            <article class="card entry">
              <div class="entry-head">
                <h3>{x.role}</h3>
                <span class="pill num">{x.period}</span>
              </div>
              <p class="accent">{x.org}</p>
              <p class="muted small">{x.place}</p>
              <ul class="exp-list">{x.items.map((i) => <li>{i}</li>)}</ul>
              {x.link && <a class="small" href={`#${x.link}`}>→ {ui.labels.seeProject}</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="research" aria-labelledby="h-research">
        <h2 class="section-title" id="h-research">{ui.sections.research}</h2>
        <div class="stack">
          {c.research.map((r) => {
            const others = (r.images ?? []).filter((im) => im.file !== r.thumb);
            const v = r.video && videoById[r.video.youtubeId];
            return (
              <article class="card project" id={r.id} aria-labelledby={`t-${r.id}`}>
                <div class="entry-head">
                  <h3 id={`t-${r.id}`}>{r.title}</h3>
                  <span class="pill">{r.category}</span>
                </div>
                <p class="accent">{r.org}</p>
                {r.period && <p class="muted small num">{r.period}</p>}
                <p class="summary">{r.summary}</p>
                <p class="role-line"><strong>{ui.labels.myRole}{COLON}</strong>{r.brief}</p>
                <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>

                <div class:list={['media', { 'has-video': !!v }]}>
                  {v ? (
                    <div class="media-main" id={`video-${v.youtubeId}`}>
                      <Video id={v.youtubeId} title={v.title} label={`${ui.labels.playVideo}${COLON}${v.title}`} poster={img(r.thumb)} />
                    </div>
                  ) : (
                    <div class="media-main">
                      <Image class="media-img" src={img(r.thumb)} alt={r.thumbAlt} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 420px" loading="lazy" />
                    </div>
                  )}
                  {others.length > 0 && (
                    <ul class="media-grid" aria-label={ui.labels.photos}>
                      {others.slice(0, 4).map((im) => (
                        <li><a href={`#${figId(im.file)}`}>
                          <Image src={img(im.file)} alt={im.caption} widths={[240, 480]} sizes="160px" loading="lazy" />
                        </a></li>
                      ))}
                    </ul>
                  )}
                </div>

                <details class="more">
                  <summary>{ui.labels.more}<span class="visually-hidden">{COLON}{r.title}</span></summary>
                  <div class="more-body">
                    <p>{r.overview}</p>
                    <p class="muted small">{r.orgFull}</p>
                    <div class="more-grid">
                      {r.method && <div><h4>{ui.labels.method}</h4><ul>{r.method.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.system && <div><h4>{ui.labels.system}</h4><p>{r.system}</p></div>}
                      {r.design && <div><h4>{ui.labels.design}</h4><ul>{r.design.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.contributions?.length > 0 && <div><h4>{ui.labels.contributions}</h4><ul>{r.contributions.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.team && <div><h4>{ui.labels.team}</h4><p>{r.team}</p></div>}
                      {r.results?.length > 0 && <div><h4>{ui.labels.results}</h4><ul class="num">{r.results.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.challenges && <div><h4>{ui.labels.challenges}</h4><ul>{r.challenges.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.next && <div><h4>{ui.labels.next}</h4><ul>{r.next.map((m) => <li>{m}</li>)}</ul></div>}
                      {r.reflection && <div><h4>{ui.labels.reflection}</h4><p>{r.reflection}</p></div>}
                    </div>
                    {r.images?.length > 0 && (
                      <div class="figs">
                        {r.images.map((im) => (
                          <figure class:list={{ wide: im.wide }} id={figId(im.file)}>
                            <Image src={img(im.file)} alt={im.alt} widths={im.wide ? [560, 1040] : [280, 560]}
                                   sizes={im.wide ? '(max-width: 860px) 100vw, 480px' : '(max-width: 860px) 50vw, 240px'} loading="lazy" />
                            <figcaption>{im.caption}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                  </div>
                </details>
              </article>
            );
          })}
        </div>
        <p class="muted small video-note">{ui.videoConsent}</p>
      </section>

      <section class="section" id="publications" aria-labelledby="h-pubs">
        <h2 class="section-title" id="h-pubs">{ui.sections.publications}</h2>
        <div class="stack">
          {c.publications.map((p) => (
            <article class="card entry pub" id={p.id}>
              <div class="entry-head">
                <h3 lang={/[一-鿿]/.test(p.title) ? 'zh-Hant-TW' : 'en'}>{p.title}</h3>
                {p.status && <span class:list={['pill', p.statusKind]}>{p.status}</span>}
              </div>
              {p.titleEn && <p class="muted small" lang="en">{p.titleEn}</p>}
              <p class="accent">{p.type}{SEP}{p.venue}</p>
              <p class="muted small num">{p.date ?? p.year}</p>
              {p.note && <p class="muted small">{p.note}</p>}
              <details class="abstract">
                <summary>{ui.labels.showAbstract}<span class="visually-hidden">{COLON}{p.title}</span></summary>
                <p>{p.abstract}</p>
              </details>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="awards" aria-labelledby="h-awards">
        <h2 class="section-title" id="h-awards">{ui.sections.awards}</h2>
        <div class="stack">
          {c.awards.map((a) => (
            <article class="card entry">
              <div class="entry-head">
                <h3>{a.title}</h3>
                {a.year && <span class="pill num">{a.year}</span>}
              </div>
              <p class="accent">{a.org}</p>
              {a.note && <p class="muted small">{a.note}</p>}
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="activities" aria-labelledby="h-acts">
        <h2 class="section-title" id="h-acts">{ui.sections.activities}</h2>
        <div class="acts">
          {c.activities.map((a) => (
            <article class="card act">
              {a.images?.[0] && <Image src={img(a.images[0].file)} alt={a.images[0].alt} widths={[360, 720]} sizes="(max-width: 700px) 100vw, 300px" loading="lazy" />}
              <div class="act-body">
                <h3>{a.title}</h3>
                <p class="accent small">{a.org}{a.role && `${SEP}${a.role}`}</p>
                <p class="small">{a.summary}</p>
                {a.link && <a class="small" href={a.link} rel="noopener">{ui.labels.link} ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>

  <!-- 點 Email 圖示時的提示：顯示信箱、已複製，並提供 Gmail 寄信連結 -->
  <div class="toast" role="status" aria-live="polite" hidden data-copied={`${ui.labels.emailCopied}${COLON}`} data-label={`Email${COLON}`}>
    <span class="toast-text"></span>
    <a class="toast-gmail" href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(c.contact.email)}`} target="_blank" rel="noopener">{ui.labels.openGmail}</a>
    <button class="toast-close" type="button" aria-label={ui.labels.close}>×</button>
  </div>

  <footer class="footer">
    <div class="wrap">
      <span>© 2026 {c.meta.name}{SEP}{ui.updated} <span class="num">{c.updated}</span></span>
      <span class="tools"><a class="btn" href={cvUrl} download type="application/pdf">{ui.downloadCv}</a></span>
    </div>
  </footer>

  <script>
    // 語言切換：記住選擇，並保留目前看到的區塊（#hash）。
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
      a.addEventListener('click', (e) => {
        try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
        if (location.hash) { e.preventDefault(); location.href = a.href + location.hash; }
      });
    });
    // 深色／淺色切換：記在 localStorage。
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const isDark = () => {
      const t = document.documentElement.dataset.theme;
      return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    };
    const sync = () => toggle?.setAttribute('aria-pressed', String(isDark()));
    sync();
    toggle?.addEventListener('click', () => {
      const root = document.documentElement;
      root.dataset.theme = isDark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      sync();
    });
    // 連到專案裡的圖片時，自動展開該專案的詳細內容。
    const openTarget = () => {
      if (!location.hash) return;
      let id;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const el = document.getElementById(id);
      // 錨點可能落在卡片本身（<details> 在其內）或圖片（<details> 在其祖先）。
      const details = el?.closest('details') || el?.querySelector('details');
      if (el && details && !details.open) details.open = true;
      if (el) el.scrollIntoView({ block: 'center' });
    };
    addEventListener('hashchange', openTarget); openTarget();
    // 最新動態：日期在今天之後的項目標示「即將」（在瀏覽器端判斷，不會因為網站沒重新部署而過期）。
    const now = new Date();
    const thisMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    document.querySelectorAll<HTMLElement>('.news time').forEach((t) => {
      const d = t.getAttribute('datetime') ?? '';
      if ((d.length === 7 && d > thisMonth) || (d.length === 4 && d > thisMonth.slice(0, 4))) t.parentElement?.querySelector<HTMLElement>('.upcoming')?.removeAttribute('hidden');
    });

    // Email：很多電腦沒有設定預設郵件程式，按 mailto 會沒反應。
    // 所以點擊時同時複製信箱並顯示提示（含 Gmail 寄信連結）；有郵件程式的人照樣會開啟。
    const toast = document.querySelector<HTMLElement>('.toast');
    const toastText = toast?.querySelector<HTMLElement>('.toast-text');
    let toastTimer: number | undefined;
    document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => {
      a.addEventListener('click', () => {
        const email = a.dataset.email!;
        const show = (copied: boolean) => {
          if (!toast || !toastText) return;
          toastText.textContent = `${copied ? toast.dataset.copied : toast.dataset.label}${email}`;
          toast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => { toast.hidden = true; }, 8000);
        };
        navigator.clipboard?.writeText(email).then(() => show(true), () => show(false)) ?? show(false);
      });
    });
    toast?.querySelector('.toast-close')?.addEventListener('click', () => { toast.hidden = true; });
  </script>
</Base>
